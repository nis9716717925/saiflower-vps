{
  "name": "saiflower",
  "private": true,
  "version": "0.1.0",
  "description": "SaiFlower monorepo — Next.js storefront + Express API + Prisma",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @saiflower/web",
    "dev:server": "npm run dev -w @saiflower/server",
    "build:packages": "npm run build -w @saiflower/shared && npm run build -w @saiflower/prisma",
    "build": "npm run build:packages && npm run build -w @saiflower/server && npm run build -w @saiflower/web",
    "build:web": "npm run build:packages && npm run build -w @saiflower/web",
    "build:server": "npm run build:packages && npm run build -w @saiflower/server",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:pull": "npm run pull -w @saiflower/prisma",
    "db:generate": "npm run generate -w @saiflower/prisma",
    "db:studio": "npm run studio -w @saiflower/prisma",
    "db:migrate:deploy": "npm run migrate:deploy -w @saiflower/prisma",
    "db:migrate:status": "npm run migrate:status -w @saiflower/prisma",
    "db:convert": "python tools/mysql-to-pg/convert_dump.py",
    "db:load": "node tools/mysql-to-pg/load-postgresql.mjs",
    "db:verify": "node tools/mysql-to-pg/verify-counts.mjs",
    "db:supabase:setup": "npm run db:migrate:deploy && npm run db:load && npm run db:verify",
    "diagnose": "node tools/diagnose/vps-check.mjs",
    "smoke": "node tools/smoke/smoke.mjs",
    "smoke:routes": "node tools/smoke/route-inventory.mjs",
    "uploads:pack": "node tools/deploy/package-uploads.mjs",
    "uploads:supabase": "node tools/deploy/upload-to-supabase.mjs",
    "deploy:web": "npm run build:web && node tools/deploy/verify-next-static.mjs",
    "deploy:probe": "node tools/deploy/probe-live-chunks.mjs",
    "setup:uploads": "bash scripts/vps/setup-uploads.sh"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
