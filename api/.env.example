# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database — choose ONE option:
# ---------------------------------------------------------------------------

# Option 1: Local MySQL (XAMPP)
# DATABASE_URL="mysql://root:@localhost:3306/saiflower_api"

# Option 2: Hostinger MySQL (remote — enable Remote MySQL in hPanel first)
# Get host/user/db from: hPanel → Databases → MySQL Databases
# DATABASE_URL="mysql://u123456789_user:YOUR_PASSWORD@srv1234.hstgr.io:3306/u123456789_saiflower"

DATABASE_URL="mysql://user:password@localhost:3306/saiflower_api"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://saiflower.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# App branding (returned via /settings)
APP_NAME=Saiflower
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL=₹
APP_MAINTENANCE_MODE=false

# Payment providers (toggle on/off)
PAYMENT_STRIPE_ENABLED=false
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_PAYPAL_ENABLED=false
PAYMENT_PAYPAL_CLIENT_ID=
PAYMENT_RAZORPAY_ENABLED=true
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
PAYMENT_COD_ENABLED=true

# OAuth (social login)
# Web GIS Client ID (ID token audience). No client secret needed for GIS ID tokens.
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=591122868014-s8k3fdmgnb8kl186vpnner41d6bisb9b.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=

# Password reset
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Legacy media host (for category/flower image files)
MEDIA_BASE_URL=https://saiflower.com
