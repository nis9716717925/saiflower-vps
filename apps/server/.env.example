# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Hostinger MySQL (REQUIRED) — same DB as PHP production
# hPanel → Databases → MySQL Databases (copy host / user / password / db name)
# Also enable your IP: Databases → Remote MySQL
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://USER:PASSWORD@HOSTNAME:3306/DATABASE_NAME"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,https://saiflower.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

APP_NAME=Sai Flower
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL=₹
APP_MAINTENANCE_MODE=false
PUBLIC_SITE_URL=https://saiflower.com
ADMIN_ORDER_EMAIL=searchlifterhexa@gmail.com

CHECKOUT_MODE=whatsapp_confirm
WHATSAPP_E164=918802004527

SHIPPING_RATE_PER_KM=25
STORE_LAT=28.5893714
STORE_LNG=77.2289164
STORE_ADDRESS=Shop No 1, Sai Mandir, Lodhi Rd, Gokalpuri, Institutional Area, Lodi Colony, New Delhi, Delhi 110003
GOOGLE_MAPS_API_KEY=
# Enable Distance Matrix, Places, Place Details, and Geocoding APIs for checkout,
# address autocomplete, and automatic location detection.

MEDIA_BASE_URL=https://saiflower.com

OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the web app for GIS sign-in.

MAIL_FROM=no-reply@saiflower.com
