{
  "name": "@saiflower/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema for SaiFlower — legacy tables migrated to Supabase PostgreSQL",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "pull": "prisma db pull",
    "studio": "prisma studio",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "schema": "schema.prisma"
  }
}
